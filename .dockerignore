# Root level .dockerignore for multi-service builds

# Dependencies
**/node_modules
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Testing
**/coverage
**/.nyc_output
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
**/__tests__
**/__mocks__

# Environment files
**/.env.local
**/.env.development
**/.env.test
**/*.local

# Build outputs
**/dist
**/build
**/.vite
**/.cache

# IDE and editor files
.vscode
.idea
**/*.swp
**/*.swo
**/*~
.DS_Store

# Git
.git
.gitignore
.gitattributes

# Documentation
README.md
VISITOR_FLOW_TEST.md
API_DOCUMENTATION.md
docs/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Postman collections
*.postman_collection.json

# Logs
**/logs
**/*.log

# Misc
**/.eslintcache
**/.prettierignore
**/tsconfig.tsbuildinfo

# Keep these
!prisma/schema.prisma
!prisma/migrations/
