# Server Configuration
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/journal_db?schema=public"

# JWT
JWT_SECRET="your_jwt_secret_key"
JWT_EXPIRE=30d

# Email Configuration
# Email Provider Selection (sendgrid or mailjet)
# If not set, will auto-select based on which provider is configured
EMAIL_PROVIDER=sendgrid

# SendGrid Configuration
SENDGRID_API_KEY="your_sendgrid_api_key"

# Mailjet Configuration
MAILJET_API_KEY="your_mailjet_api_key"
MAILJET_API_SECRET="your_mailjet_api_secret"

# Common Email Settings
FROM_EMAIL="noreply@example.com"
FROM_NAME="Journal System"

# File Storage (Backblaze B2)
B2_APPLICATION_KEY_ID="your_b2_key_id"
B2_APPLICATION_KEY="your_b2_application_key"
B2_BUCKET_ID="your_b2_bucket_id"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Frontend URL (for CORS and links)
FRONTEND_URL="http://localhost:5173"

# hCaptcha
HCAPTCHA_SECRET_KEY="your_hcaptcha_secret_key"
